# Required runtime configuration
DATABASE_URL=
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=
DASHBOARD_PASSWORD=

# n8n → Dashboard. Configure the same secret in the n8n workflow.
N8N_EVENTS_SECRET=

# Dashboard → n8n. Set the header name to match the workflow's Header Auth credential.
N8N_ADMIN_WEBHOOK_URL="https://7pq44p57.rpcld.app/webhook/lumiere-dashboard-admin"
N8N_ADMIN_HEADER_NAME=
N8N_ADMIN_SECRET=

# Optional Prisma seed account (only used by prisma/seed.ts)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

NEXT_PUBLIC_APP_URL="http://localhost:3000"
