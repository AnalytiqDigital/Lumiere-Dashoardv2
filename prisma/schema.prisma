generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPERVISOR
  AGENT
}

enum ConversationStatus {
  OPEN
  AI_HANDLED
  AWAITING_HUMAN
  HUMAN_HANDLED
  FOLLOWED_UP
  CLOSED
  LEAD
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSender {
  CUSTOMER
  AI
  AGENT
  SYSTEM
}

enum HandoffStatus {
  OPEN
  ASSIGNED
  RESOLVED
  CLOSED
}

model Business {
  id                    String   @id @default(cuid())
  name                  String
  slug                  String   @unique
  logoUrl               String?
  primaryColor          String   @default("#F5A623")
  description           String?
  whatsappPhoneNumber   String?
  whatsappPhoneNumberId String?
  whatsappBusinessId    String?
  n8nWebhookUrl         String?
  n8nAdminWebhookUrl    String?
  timezone              String   @default("Africa/Lagos")
  currency              String   @default("NGN")
  supportEmail          String?
  supportPhone          String?
  address               String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  users         User[]
  customers     Customer[]
  conversations Conversation[]
  products      Product[]
  settings      IntegrationSetting[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(AGENT)
  businessId   String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business     Business      @relation(fields: [businessId], references: [id])
  assignments  Assignment[]
  handoffs     Handoff[]
  messages     Message[]
  auditLogs    AuditLog[]
}

model Customer {
  id              String   @id @default(cuid())
  businessId      String
  whatsappId      String
  phoneNumber     String
  name            String?
  pushName        String?
  tags            String[] @default([])
  notes           String?
  lastSeenAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business        Business       @relation(fields: [businessId], references: [id])
  conversations   Conversation[]

  @@unique([businessId, whatsappId])
  @@index([businessId, phoneNumber])
}

model Conversation {
  id              String             @id @default(cuid())
  businessId      String
  customerId      String
  status          ConversationStatus @default(OPEN)
  summary         String?
  isUnread        Boolean            @default(true)
  lastMessageAt   DateTime           @default(now())
  lastMessageText String?
  assignedToId    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  business        Business           @relation(fields: [businessId], references: [id])
  customer        Customer           @relation(fields: [customerId], references: [id])
  messages        Message[]
  handoffs        Handoff[]
  assignments     Assignment[]
  events          ConversationEvent[]

  @@index([businessId, status])
  @@index([businessId, lastMessageAt])
}

model Message {
  id              String           @id @default(cuid())
  conversationId  String
  externalId      String?          // WhatsApp message ID for dedup
  direction       MessageDirection
  sender          MessageSender
  content         String
  mediaUrl        String?
  mediaType       String?
  status          String?          // sent, delivered, read, failed
  agentId         String?
  createdAt       DateTime         @default(now())

  conversation    Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent           User?            @relation(fields: [agentId], references: [id])

  @@unique([externalId])
  @@index([conversationId, createdAt])
}

model Handoff {
  id              String        @id @default(cuid())
  conversationId  String
  status          HandoffStatus @default(OPEN)
  reason          String?
  requestedAt     DateTime      @default(now())
  assignedToId    String?
  resolvedAt      DateTime?
  closedAt        DateTime?
  notes           String?

  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assignedTo      User?         @relation(fields: [assignedToId], references: [id])
}

model Assignment {
  id              String   @id @default(cuid())
  conversationId  String
  userId          String
  assignedAt      DateTime @default(now())
  unassignedAt    DateTime?

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id])
}

model Product {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  price       Decimal? @db.Decimal(12, 2)
  currency    String   @default("NGN")
  category    String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id])
}

model ConversationEvent {
  id              String   @id @default(cuid())
  conversationId  String
  type            String
  payload         Json?
  createdAt       DateTime @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model IntegrationSetting {
  id          String   @id @default(cuid())
  businessId  String
  key         String
  value       String
  isSecret    Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, key])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
}
